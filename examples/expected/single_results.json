  "metric_definitions": {
    "onsets": "Hit onsets detected with librosa (onset strength with reflect padding, ~3.3 ms hop, peak-picking threshold 0.3) in the audio up to the clip's duration.",
    "hit_f1": "Headline: F-measure of the detected onsets against the annotated hits, one-to-one matching within +-0.1 s (mir_eval.onset.f_measure), per seed; mean over seeds (a missing seed scores 0), then over clips.",
    "hit_precision": "Fraction of the detected onsets matched to an annotated hit; same matching and means.",
    "hit_coverage": "Recall: fraction of the annotated hits matched by a detected onset; same matching and means.",
    "timing_error_ms": "Mean |detected - annotated| time (ms) of a seed's matched hits (each within +-0.1 s), mean over the seeds with at least one match; read it with hit F1, since unmatched hits do not count.",
    "timing_offset_ms": "Diagnostic: per annotated hit, the median over seeds of (nearest detected onset - hit time) when within +-0.25 s; median over hits (positive = late audio).",
    "timing_drift_ms_per_s": "Diagnostic: Theil-Sen slope (scipy.stats.theilslopes) of those per-hit medians (ms) against hit time (s); nonzero = time-scale mismatch. Read offset and drift only when hit F1 is well above chance.",
    "ci95": "95% percentile bootstrap interval: 2000 resamples (seed 0) of whole caption groups (clips sharing a caption); every model gets the same resamples."
  },
